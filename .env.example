# --- Database ---
# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/emailplatform"

# --- Auth ---
# Long random string used to sign session JWTs. Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"
# Days before a session expires
SESSION_TTL_DAYS=14

# --- Mail domain ---
# The domain new user addresses are created on, e.g. user gets alice@MAIL_DOMAIN
MAIL_DOMAIN="mydomain.com"

# --- Outbound / inbound mail provider (Postmark) ---
# Used for delivering mail to external providers (Gmail, Outlook, Yahoo, etc.)
# and for receiving mail sent to your domain from the outside world via
# Postmark's inbound webhook. See README.md for full DNS + provider setup.
POSTMARK_SERVER_TOKEN="replace-with-postmark-server-token"
POSTMARK_INBOUND_WEBHOOK_SECRET="replace-with-a-shared-secret-you-choose"

# --- Attachments ---
# "local" stores files on disk under /uploads (dev only).
# "s3" stores files in an S3-compatible bucket (recommended for production).
ATTACHMENT_STORAGE=local
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MAX_ATTACHMENT_MB=25

# --- Rate limiting ---
LOGIN_RATE_LIMIT_PER_15MIN=10
SEND_RATE_LIMIT_PER_HOUR=100
